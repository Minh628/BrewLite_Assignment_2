{
  "apps/api/**/*.{ts,js}": [
    "eslint --fix --config apps/api/eslint.config.mjs",
    "prettier --write"
  ],
  "apps/api/**/*.json": ["prettier --write"],
  "apps/web/**/*.{ts,tsx,js,jsx}": [
    "eslint --fix --config apps/web/eslint.config.mjs",
    "prettier --write"
  ],
  "apps/web/**/*.{json,css}": ["prettier --write"],
  "tests/**/*.{ts,js}": ["eslint --fix --config apps/api/eslint.config.mjs", "prettier --write"],
  "*.{json,md,yml,yaml}": ["prettier --write"]
}
